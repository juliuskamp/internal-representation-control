HF_TOKEN=your_hf_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: Hugging Face cache location. Defaults to ~/.cache/huggingface;
# set it if that volume has no room for the ~55 GB of weights.
# HF_HOME=/path/to/hf-cache
# Optional: local snapshot dir of the NLA actor checkpoint, if it lives
# outside HF_HOME (otherwise scripts/nla_explain.py resolves it via the HF
# cache, downloading only the tokenizer/config/embedding-shard files it needs)
# NLA_AV_CHECKPOINT=/path/to/models--kitft--nla-gemma3-27b-L41-av/snapshots/<commit>